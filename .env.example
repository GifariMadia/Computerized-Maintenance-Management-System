# ==============================================================================
# CMMS — PT Bintang Toedjoe Site Pulogadung
# Environment Configuration Template (Linux / Docker)
# ==============================================================================
# Copy this file to .env and update secret values before running locally.

# Timezone (URS 2.1: Aplikasi menampilkan waktu dalam WIB)
TZ=Asia/Jakarta

# Environment: development | staging | production
APP_ENV=development

# PostgreSQL Database (Single Operational DB — URS 2.2)
POSTGRES_DB=cmms_db
POSTGRES_USER=cmms_app
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5432

# Backend Go API
BACKEND_PORT=8080
DATABASE_URL=postgres://cmms_app:change_me_strong_password@postgres:5432/cmms_db?sslmode=disable&TimeZone=Asia/Jakarta
JWT_SECRET=change_me_jwt_secret_min_32_chars
AUTH_MAX_FAILED_ATTEMPTS=3
AUTH_LOCKOUT_MINUTES=15
SESSION_TIMEOUT_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Document Storage (MinIO S3-compatible — URS 3 Interfaces: Foto, Manual, Datasheet)
MINIO_ROOT_USER=cmms_minio
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=cmms-documents

# Frontend Next.js
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=CMMS PT Bintang Toedjoe Site Pulogadung
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta
