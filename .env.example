# ==============================================================================
# CMMS — PT Bintang Toedjoe Site Pulogadung
# Environment Configuration Template (Linux / Docker)
# ==============================================================================
# Copy this file to .env and replace ALL placeholder secrets before running:
#   cp .env.example .env
#
# IMPORTANT: docker-compose.yml intentionally has NO fallback passwords/secrets.
# POSTGRES_PASSWORD, JWT_SECRET (>= 32 chars), and MINIO_ROOT_PASSWORD are REQUIRED.

# Timezone (URS 2.1: Aplikasi menampilkan waktu dalam WIB)
TZ=Asia/Jakarta

# Environment: development | staging | production
APP_ENV=development

# Host bind addresses (default 127.0.0.1 agar DB & MinIO tidak terekspos ke seluruh LAN)
# Untuk akses LAN pada frontend/backend, gunakan 0.0.0.0 atau IP interface internal perusahaan.
POSTGRES_BIND_ADDR=127.0.0.1
MINIO_BIND_ADDR=127.0.0.1
BACKEND_BIND_ADDR=0.0.0.0
FRONTEND_BIND_ADDR=0.0.0.0

# PostgreSQL Database (Single Operational DB — URS 2.2)
POSTGRES_DB=cmms_db
POSTGRES_USER=cmms_app
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_PORT=5432

# Backend Go API
BACKEND_PORT=8080
# Untuk local `make backend-dev` di luar Docker, ubah host `postgres` -> `127.0.0.1`
DATABASE_URL=postgres://cmms_app:replace_with_strong_postgres_password@postgres:5432/cmms_db?sslmode=disable&TimeZone=Asia/Jakarta
# Minimal 32 karakter (contoh generator: openssl rand -hex 32)
JWT_SECRET=replace_with_at_least_32_characters_random_jwt_secret_key
AUTH_MAX_FAILED_ATTEMPTS=3
AUTH_LOCKOUT_MINUTES=15
SESSION_TIMEOUT_MINUTES=60
# Mendukung multi-origin dipisah koma untuk localhost & akses LAN
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# S3-Compatible Document Storage (Silo / MinIO API — URS Bab 3 Interfaces)
# MINIO_ENDPOINT digunakan internal oleh Backend Go di jaringan Docker (minio:9000)
# MINIO_PUBLIC_URL digunakan untuk presigned download URL yang diakses browser/LAN
MINIO_ROOT_USER=cmms_minio
MINIO_ROOT_PASSWORD=replace_with_strong_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=cmms-documents
MINIO_USE_SSL=false

# Frontend Next.js
FRONTEND_PORT=3000
# URL internal antar container untuk Next.js Server-Side Rendering (SSR)
INTERNAL_API_URL=http://backend:8080/api/v1
# URL publik yang diakses browser pengguna (ganti localhost dengan IP/domain LAN bila diakses via LAN)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME="CMMS PT Bintang Toedjoe Site Pulogadung"
NEXT_PUBLIC_TIMEZONE=Asia/Jakarta
